{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "framework": null,
  "buildCommand": "npm run prisma:generate && npm run build",
  "rewrites": [
    {
      "source": "/api/auth",
      "destination": "/api?__hustle_auth_path="
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api?__hustle_auth_path=:path*"
    },
    {
      "source": "/",
      "destination": "/api?__hustle_path="
    },
    {
      "source": "/api/v1",
      "destination": "/api?__hustle_path="
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api?__hustle_path=:path*"
    }
  ]
}
