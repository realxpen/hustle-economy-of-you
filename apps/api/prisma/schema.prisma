generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Capability {
  CLIENT
  HUSTLER
  AGENT
}

enum CapabilityStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum HustlerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum HustlerProofType {
  PORTFOLIO
  IDENTITY_DOCUMENT
  CERTIFICATE
  BUSINESS_DOCUMENT
  OTHER
}

enum ProfessionalProfileStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                          String               @id @default(cuid())
  authSubject                 String               @unique
  email                       String?
  phone                       String?
  emailVerified               Boolean              @default(false)
  phoneVerified               Boolean              @default(false)
  displayName                 String?
  username                    String?              @unique
  bio                         String?
  location                    String?
  avatarUrl                   String?
  onboardingCompleted         Boolean              @default(false)
  capabilities                UserCapability[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  hustlerApplication          HustlerApplication?  @relation("HustlerApplicant")
  reviewedHustlerApplications HustlerApplication[] @relation("HustlerReviewer")
  professionalProfile         ProfessionalProfile?
}

model UserCapability {
  id         String           @id @default(cuid())
  userId     String
  capability Capability
  status     CapabilityStatus @default(ACTIVE)
  enabledAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([capability, status])
}

model HustlerApplication {
  id     String                   @id @default(cuid())
  userId String                   @unique
  status HustlerApplicationStatus @default(DRAFT)

  primarySkill      String?
  category          String?
  experienceSummary String?
  yearsExperience   Int?

  businessName String?
  businessInfo String?

  identityVerificationStatus VerificationStatus @default(NOT_STARTED)

  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewerId      String?
  reviewNotes     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("HustlerApplicant", fields: [userId], references: [id], onDelete: Cascade)

  reviewer User? @relation("HustlerReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  proofs HustlerApplicationProof[]

  @@index([status])
  @@index([category])
}

model HustlerApplicationProof {
  id            String           @id @default(cuid())
  applicationId String
  type          HustlerProofType
  storageKey    String           @unique
  fileName      String
  mimeType      String
  sizeBytes     Int?
  createdAt     DateTime         @default(now())

  application HustlerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, type])
}

model ProfessionalProfile {
  id                  String                    @id @default(cuid())
  userId              String                    @unique
  headline            String?
  coverUrl            String?
  primarySkill        String?
  secondarySkills     String[]                  @default([])
  category            String?
  professionalSummary String?
  yearsExperience     Int?
  status              ProfessionalProfileStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([category])
}

model SystemEvent {
  id         String   @id @default(cuid())
  name       String
  source     String
  payload    Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([name, occurredAt])
}
