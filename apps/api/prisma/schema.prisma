generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Capability {
  CLIENT
  HUSTLER
  AGENT
}

enum CapabilityStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum HustlerApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum HustlerProofType {
  PORTFOLIO
  IDENTITY_DOCUMENT
  CERTIFICATE
  BUSINESS_DOCUMENT
  OTHER
}

enum ProfessionalProfileStatus {
  DRAFT
  PUBLISHED
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum ServicePricingType {
  FIXED
  STARTING_AT
  HOURLY
}

enum ServiceDeliveryMode {
  REMOTE
  PHYSICAL
  BOTH
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostMediaType {
  IMAGE
  VIDEO
}

model User {
  id                          String               @id @default(cuid())
  authSubject                 String               @unique
  email                       String?
  phone                       String?
  emailVerified               Boolean              @default(false)
  phoneVerified               Boolean              @default(false)
  displayName                 String?
  username                    String?              @unique
  bio                         String?
  location                    String?
  avatarUrl                   String?
  onboardingCompleted         Boolean              @default(false)
  capabilities                UserCapability[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  hustlerApplication          HustlerApplication?  @relation("HustlerApplicant")
  reviewedHustlerApplications HustlerApplication[] @relation("HustlerReviewer")
  professionalProfile         ProfessionalProfile?
}

model UserCapability {
  id         String           @id @default(cuid())
  userId     String
  capability Capability
  status     CapabilityStatus @default(ACTIVE)
  enabledAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([capability, status])
}

model HustlerApplication {
  id     String                   @id @default(cuid())
  userId String                   @unique
  status HustlerApplicationStatus @default(DRAFT)

  primarySkill      String?
  category          String?
  experienceSummary String?
  yearsExperience   Int?

  businessName String?
  businessInfo String?

  identityVerificationStatus VerificationStatus @default(NOT_STARTED)

  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewerId      String?
  reviewNotes     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("HustlerApplicant", fields: [userId], references: [id], onDelete: Cascade)

  reviewer User? @relation("HustlerReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  proofs HustlerApplicationProof[]

  @@index([status])
  @@index([category])
}

model HustlerApplicationProof {
  id            String           @id @default(cuid())
  applicationId String
  type          HustlerProofType
  storageKey    String           @unique
  fileName      String
  mimeType      String
  sizeBytes     Int?
  createdAt     DateTime         @default(now())

  application HustlerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, type])
}

model ProfessionalProfile {
  id                  String                    @id @default(cuid())
  userId              String                    @unique
  headline            String?
  coverUrl            String?
  primarySkill        String?
  secondarySkills     String[]                  @default([])
  category            String?
  professionalSummary String?
  yearsExperience     Int?
  status              ProfessionalProfileStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services Service[]
  products Product[]
  posts    Post[]

  @@index([status])
  @@index([category])
}

model Service {
  id                    String              @id @default(cuid())
  professionalProfileId String
  title                 String?
  category              String?
  description           String?
  mediaUrls             String[]            @default([])
  priceMinor            Int?
  currency              String              @default("NGN")
  pricingType           ServicePricingType  @default(FIXED)
  deliveryMode          ServiceDeliveryMode @default(REMOTE)
  location              String?
  availabilityNote      String?
  deliveryTime          String?
  requirements          String?
  status                ServiceStatus       @default(DRAFT)
  publishedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  professionalProfile ProfessionalProfile     @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  postAttachments     PostServiceAttachment[]

  @@index([professionalProfileId, status])
  @@index([status, category])
  @@index([createdAt])
}

model Product {
  id                    String        @id @default(cuid())
  professionalProfileId String
  title                 String?
  description           String?
  category              String?
  mediaUrls             String[]      @default([])
  type                  ProductType   @default(PHYSICAL)
  priceMinor            Int?
  currency              String        @default("NGN")
  trackInventory        Boolean       @default(false)
  inventoryQuantity     Int?
  deliveryInformation   String?
  status                ProductStatus @default(DRAFT)
  publishedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  professionalProfile ProfessionalProfile     @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  variants            ProductVariant[]
  postAttachments     PostProductAttachment[]

  @@index([professionalProfileId, status])
  @@index([status, category])
  @@index([createdAt])
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  name               String
  sku                String?
  optionValues       Json?
  priceOverrideMinor Int?
  inventoryQuantity  Int?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId, isActive])
}

model Post {
  id                    String     @id @default(cuid())
  professionalProfileId String
  caption               String?
  category              String?
  location              String?
  tags                  String[]   @default([])
  status                PostStatus @default(DRAFT)
  publishedAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  professionalProfile ProfessionalProfile     @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  media               PostMedia[]
  serviceAttachments  PostServiceAttachment[]
  productAttachments  PostProductAttachment[]

  @@index([professionalProfileId, status])
  @@index([status, createdAt])
  @@index([category])
}

model PostMedia {
  id         String        @id @default(cuid())
  postId     String
  type       PostMediaType
  storageKey String?
  mediaUrl   String?
  position   Int           @default(0)
  width      Int?
  height     Int?
  durationMs Int?
  createdAt  DateTime      @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
}

model PostServiceAttachment {
  postId    String
  serviceId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([postId, serviceId])
  @@index([serviceId])
}

model PostProductAttachment {
  postId    String
  productId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
}

model SystemEvent {
  id         String   @id @default(cuid())
  name       String
  source     String
  payload    Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([name, occurredAt])
}
