enum StoryType {
  TEXT
  IMAGE
  VIDEO
}

model Story {
  id          String    @id @default(cuid())
  userId      String
  type        StoryType
  text        String?
  mediaUrl    String?
  background  String?
  serviceId   String?
  productId   String?
  publishedAt DateTime  @default(now())
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt, publishedAt])
  @@index([userId, expiresAt])
  @@index([serviceId])
  @@index([productId])
}
