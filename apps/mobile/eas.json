{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "isolated-staging": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_HUSTLE_APP_VARIANT": "preview",
        "EXPO_PUBLIC_HUSTLE_RUNTIME_SCOPE": "isolated-staging",
        "EXPO_PUBLIC_HUSTLE_AUTH_PROVIDER": "expo-better-auth",
        "EXPO_PUBLIC_HUSTLE_AUTH_URL": "https://hustle-isolated-staging-api.vercel.app/api/auth",
        "EXPO_PUBLIC_API_URL": "https://hustle-isolated-staging-api.vercel.app/api/v1",
        "EXPO_PUBLIC_HUSTLE_DEMO": "false",
        "EXPO_PUBLIC_HUSTLE_ENABLE_ENQUIRY_MESSAGES": "true",
        "EXPO_PUBLIC_HUSTLE_ENABLE_BOOKING_REQUESTS": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_HUSTLE_DEMO": "false",
        "EXPO_PUBLIC_HUSTLE_ENABLE_ENQUIRY_MESSAGES": "true",
        "EXPO_PUBLIC_HUSTLE_ENABLE_BOOKING_REQUESTS": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "demo": {
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_HUSTLE_DEMO": "true",
        "EXPO_PUBLIC_HUSTLE_ENABLE_ENQUIRY_MESSAGES": "false",
        "EXPO_PUBLIC_HUSTLE_ENABLE_BOOKING_REQUESTS": "false",
        "EXPO_PUBLIC_API_URL": "https://hustle-offline-demo.invalid/api/v1",
        "EXPO_PUBLIC_SUPABASE_URL": "https://hustle-offline-demo.invalid",
        "EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_demo_not_a_real_key"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
