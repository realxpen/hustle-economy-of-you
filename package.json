{
  "name": "hustle-economy-of-you",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace=@hustle/web",
    "dev:admin": "npm run dev --workspace=@hustle/admin",
    "dev:api": "npm run dev --workspace=@hustle/api",
    "dev:mobile": "npm run start --workspace=@hustle/mobile",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "phase2:gate": "node scripts/phase2-gate-check.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "ci": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
