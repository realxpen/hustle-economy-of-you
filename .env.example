NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3001
ADMIN_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hustle?schema=public
REDIS_URL=redis://localhost:6379

# Phase 2 — dedicated Hustle Supabase project
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this value through NEXT_PUBLIC/EXPO_PUBLIC variables.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Phase 3 — temporary internal review allow-list.
# Comma-separated verified emails. Full admin authorization is owned by Phase 19.
HUSTLE_REVIEWER_EMAILS=

STORAGE_PROVIDER=unconfigured
STORAGE_BUCKET=
STORAGE_REGION=
ANALYTICS_PROVIDER=internal
