{
  "name": "hustle-economy-of-you",
  "main": "./ui-preview/worker.mjs",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./ui-preview/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/preview/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "HUSTLE_PREVIEW_AUTH_GATE": "isolated-staging"
  }
}
